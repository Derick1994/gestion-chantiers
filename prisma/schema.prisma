// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Utilisateur {
  id                    String      @id @default(cuid())
  nom                   String
  identifiant           String      @unique
  motDePasse            String
  role                  String      @default("OPERATEUR") // ADMIN | OPERATEUR
  actif                 Boolean     @default(true)
  doitChangerMotDePasse Boolean     @default(true)
  createdAt             DateTime    @default(now())
  depenses              Depense[]
  mouvements            Mouvement[]
}

model Chantier {
  id         String      @id @default(cuid())
  nom        String
  lieu       String
  dateDebut  String
  budget     Float?
  statut     String      @default("En cours") // "En cours" | "Terminé"
  archive    Boolean     @default(false)
  createdAt  DateTime    @default(now())
  depenses   Depense[]
  mouvements Mouvement[]
}

model Categorie {
  id       String    @id @default(cuid())
  libelle  String
  type     String
  ordre    Int       @default(0)
  actif    Boolean   @default(true)
  depenses Depense[]
}

model Depense {
  id            String      @id @default(cuid())
  chantier      Chantier    @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  chantierId    String
  categorie     Categorie   @relation(fields: [categorieId], references: [id])
  categorieId   String
  date          String
  description   String?
  montant       Float
  beneficiaire  String?
  mode          String      @default("Espèces")
  reference     String?
  quantite      Float?
  prixUnitaire  Float?
  saisiPar      Utilisateur? @relation(fields: [saisiParId], references: [id])
  saisiParId    String?
  createdAt     DateTime    @default(now())

  @@index([chantierId])
  @@index([categorieId])
}

model Mouvement {
  id           String       @id @default(cuid())
  type         String       // ENTREE | DOTATION | RETOUR | SORTIE_EXTERNE | DEPENSE_GENERALE
  montant      Float
  date         String
  chantier     Chantier?    @relation(fields: [chantierId], references: [id])
  chantierId   String?
  beneficiaire String?
  note         String?
  auteur       Utilisateur? @relation(fields: [auteurId], references: [id])
  auteurId     String?
  createdAt    DateTime     @default(now())

  @@index([chantierId])
  @@index([type])
}

model JournalAudit {
  id            String   @id @default(cuid())
  dateHeure     DateTime @default(now())
  acteurId      String?  @db.VarChar(30)
  acteurNom     String
  acteurRole    String
  action        String
  entite        String   @db.VarChar(50)
  entiteId      String?  @db.VarChar(30)
  entiteLibelle String
  avant         Json?
  apres         Json?

  @@index([dateHeure])
  @@index([entite, entiteId])
  @@index([acteurId])
}
